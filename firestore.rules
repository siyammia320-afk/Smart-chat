rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isEmailAccountId(id) {
      return id is string && id.size() == 28 && id.matches('^usr_[a-f0-9]{24}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token &&
         'email_verified' in request.auth.token &&
         request.auth.token.email == 'siyammia320@gmail.com' &&
         request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function hasActiveProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked == false;
    }

    function hasActiveEmailProfile(uid) {
      return isEmailAccountId(uid) &&
             exists(/databases/$(database)/documents/users/$(uid)) &&
             get(/databases/$(database)/documents/users/$(uid)).data.isBlocked == false;
    }

    // 3. Entity Validation Blueprints
    function isValidAdminRole(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidEmailAccount(data) {
      return data.userId is string && isEmailAccountId(data.userId) &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 60 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 24 &&
             data.passwordHash is string && data.passwordHash.size() == 64 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidGroupId(gid) {
      return gid is string && gid.size() <= 64 && (gid == 'smart_chat_main' || gid == 'smart_chat_live');
    }

    function isValidUserProfile(data) {
      return data.userId is string && isValidId(data.userId) &&
             isValidGroupId(data.groupId) &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 40 &&
             data.avatarData is string && data.avatarData.size() <= 25000 &&
             data.statusText is string && data.statusText.size() <= 120 &&
             data.isBlocked is bool &&
             data.isOnline is bool &&
             data.isAdminBadge is bool &&
             data.autoDeleteHours is int && (data.autoDeleteHours == 24 || data.autoDeleteHours == 48) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatMessage(data) {
      return isValidGroupId(data.groupId) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
             data.senderAvatar is string && data.senderAvatar.size() <= 25000 &&
             data.senderIsAdmin is bool &&
             data.type is string && data.type.size() <= 16 && (data.type == 'text' || data.type == 'voice' || data.type == 'notice') &&
             data.text is string && data.text.size() <= 2000 &&
             data.audioBase64 is string && data.audioBase64.size() <= 300000 &&
             data.audioDurationSec is int && data.audioDurationSec >= 0 && data.audioDurationSec <= 120 &&
             data.replyToId is string && data.replyToId.size() <= 128 &&
             data.replyToSender is string && data.replyToSender.size() <= 40 &&
             data.replyToPreview is string && data.replyToPreview.size() <= 600 &&
             data.ttlHours is int && (data.ttlHours == 24 || data.ttlHours == 48) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 4. Collection Rules: /accounts/{accountId} (Direct Email/Password Accounts)
    match /accounts/{accountId} {
      allow get: if isEmailAccountId(accountId);
      allow list: if false;
      allow create: if isEmailAccountId(accountId) &&
                       incoming().userId == accountId &&
                       incoming().keys().hasAll(['userId', 'fullName', 'username', 'passwordHash', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'fullName', 'username', 'passwordHash', 'createdAt']) &&
                       isValidEmailAccount(incoming());
      allow update, delete: if false;
    }

    // 5. Collection Rules: /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(adminUid) &&
                       request.auth.uid == adminUid &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'createdAt']) &&
                       isValidAdminRole(incoming()) &&
                       isAdmin();
      allow update, delete: if false;
    }

    // 6. Collection Rules: /users/{userId}
    match /users/{userId} {
      allow get: if (isSignedIn() && isValidId(userId) && (request.auth.uid == userId || existing().groupId == 'smart_chat_main')) ||
                    isEmailAccountId(userId);
      allow list: if (isSignedIn() && existing().groupId == 'smart_chat_main') ||
                     existing().groupId == 'smart_chat_live';

      allow create: if isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll([
                         'userId', 'groupId', 'username', 'avatarData', 'statusText',
                         'isBlocked', 'isOnline', 'isAdminBadge', 'autoDeleteHours',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'groupId', 'username', 'avatarData', 'statusText',
                         'isBlocked', 'isOnline', 'isAdminBadge', 'autoDeleteHours',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming()) &&
                       incoming().isBlocked == false && (
                         (isSignedIn() && request.auth.uid == userId && incoming().groupId == 'smart_chat_main' && (incoming().isAdminBadge == false || isAdmin())) ||
                         (isEmailAccountId(userId) && incoming().groupId == 'smart_chat_live')
                       );

      allow update: if isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().groupId == existing().groupId &&
                       incoming().createdAt == existing().createdAt && (
                         (
                           isSignedIn() &&
                           request.auth.uid == userId &&
                           incoming().isBlocked == existing().isBlocked &&
                           (incoming().isAdminBadge == existing().isAdminBadge || isAdmin()) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'username', 'avatarData', 'statusText', 'isOnline', 'isAdminBadge', 'autoDeleteHours', 'updatedAt'
                           ])
                         ) ||
                         (
                           isSignedIn() &&
                           isAdmin() &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'isBlocked', 'statusText', 'isAdminBadge', 'autoDeleteHours', 'updatedAt'
                           ])
                         ) ||
                         (
                           isEmailAccountId(userId) &&
                           existing().groupId == 'smart_chat_live' &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'username', 'avatarData', 'statusText', 'isBlocked', 'isOnline', 'isAdminBadge', 'autoDeleteHours', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if (isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin())) ||
                       (isEmailAccountId(userId) && existing().groupId == 'smart_chat_live');
    }

    // 7. Collection Rules: /messages/{messageId}
    match /messages/{messageId} {
      allow get: if isValidId(messageId) && (
                    (isSignedIn() && existing().groupId == 'smart_chat_main') ||
                    existing().groupId == 'smart_chat_live'
                  );
      allow list: if (isSignedIn() && existing().groupId == 'smart_chat_main') ||
                     existing().groupId == 'smart_chat_live';

      allow create: if isValidId(messageId) &&
                       incoming().keys().hasAll([
                         'groupId', 'senderId', 'senderName', 'senderAvatar', 'senderIsAdmin',
                         'type', 'text', 'audioBase64', 'audioDurationSec',
                         'replyToId', 'replyToSender', 'replyToPreview',
                         'ttlHours', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'groupId', 'senderId', 'senderName', 'senderAvatar', 'senderIsAdmin',
                         'type', 'text', 'audioBase64', 'audioDurationSec',
                         'replyToId', 'replyToSender', 'replyToPreview',
                         'ttlHours', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidChatMessage(incoming()) && (
                         (
                           isSignedIn() &&
                           incoming().groupId == 'smart_chat_main' &&
                           incoming().senderId == request.auth.uid &&
                           (incoming().senderIsAdmin == false || isAdmin()) &&
                           (incoming().type != 'notice' || isAdmin()) &&
                           hasActiveProfile()
                         ) ||
                         (
                           incoming().groupId == 'smart_chat_live' &&
                           hasActiveEmailProfile(incoming().senderId)
                         )
                       );

      allow update: if isValidId(messageId) &&
                       isValidChatMessage(incoming()) &&
                       incoming().senderId == existing().senderId &&
                       incoming().groupId == existing().groupId &&
                       incoming().createdAt == existing().createdAt && (
                         (
                           isSignedIn() &&
                           request.auth.uid == existing().senderId &&
                           incoming().senderIsAdmin == existing().senderIsAdmin &&
                           incoming().type == existing().type &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['text', 'replyToPreview', 'updatedAt']) &&
                           hasActiveProfile()
                         ) ||
                         (
                           isSignedIn() &&
                           hasActiveProfile() &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['replyToPreview', 'updatedAt'])
                         ) ||
                         (
                           isSignedIn() &&
                           isAdmin() &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['text', 'type', 'replyToPreview', 'updatedAt'])
                         ) ||
                         (
                           existing().groupId == 'smart_chat_live' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['text', 'type', 'replyToPreview', 'updatedAt'])
                         )
                       );

      allow delete: if isValidId(messageId) && (
                       (
                         isSignedIn() && (
                           existing().senderId == request.auth.uid ||
                           isAdmin() ||
                           request.time > existing().createdAt + duration.value(24, 'h')
                         )
                       ) ||
                       existing().groupId == 'smart_chat_live'
                     );
    }
  }
}
